{
  "name": "@workspace/app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p $PORT",
    "build": "prisma generate && next build",
    "start": "next start -H 0.0.0.0 -p $PORT",
    "typecheck": "prisma generate && tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --check .",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "import:csv": "tsx src/cli/import-csv.ts",
    "seed:demo": "tsx src/cli/seed-demo.ts",
    "seed:pilot": "tsx src/cli/seed-pilot.ts",
    "recompute": "tsx src/cli/recompute.ts",
    "fixtures:generate": "tsx src/cli/generate-fixtures.ts",
    "fixtures:anonymize": "tsx src/cli/anonymize-qbo-report.ts",
    "import:qbo-report": "tsx src/cli/import-qbo-report.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "csv-parse": "^7.0.2",
    "decimal.js": "^10.6.0",
    "docx": "^9.7.1",
    "exceljs": "^4.4.0",
    "next": "^16.3.6",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.0",
    "react": "catalog:",
    "react-dom": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "catalog:",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.23.1",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitest/coverage-v8": "^5.0.1",
    "dotenv": "^18.0.3",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.6",
    "fast-check": "^4.10.2",
    "postcss": "^8.5.28",
    "prettier": "^3.9.6",
    "prisma": "^7.10.0",
    "tailwindcss": "catalog:",
    "tsx": "catalog:",
    "typescript": "~5.9.3",
    "vitest": "^5.0.1"
  }
}
